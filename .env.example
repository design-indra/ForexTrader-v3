# PUBLIC
NEXT_PUBLIC_SITE_NAME=ForexTrader
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# AUTH
NEXTAUTH_URL=${NEXT_PUBLIC_SITE_URL}
NEXTAUTH_SECRET=YOUR_RANDOM_64_BYTE_BASE64

# ADMIN CREDENTIALS
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD_HASH=$2a$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# DATABASE (PostgreSQL – Railway / Neon / Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# TELEGRAM (optional)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321

# RATE LIMITING
RATE_LIMIT_MAX_REQUESTS=120
MONEX_RATE_LIMIT_MAX=12

# SENTRY (production only)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
